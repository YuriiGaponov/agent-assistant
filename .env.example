# Пример файла окружения для настройки параметров приложения.
# Скопируйте этот файл в .env и измените значения при необходимости.
# Параметры ОПЦИОНАЛЬНЫ, при отсутствии какого-либо параметра
# его значение устанавливается по умолчанию.

# Проект поддерживает разделение конфигурации по средам:
# - .env.dev: настройки для локальной разработки (локальные API, отладочные флаги).
# - .env.test: параметры для тестового окружения (тестовые API, моки).
# - .env.prod: продакшен‑настройки (боевые API, оптимизированные флаги).

# Порядок настройки:
# 1. Решите, для какой среды вы настраиваете приложение.
# 2. Создайте копию этого файла с именем .env.<среда> (например, .env.production).
# 3. Внесите в новый файл все необходимые значения переменных.
# 4. В этом (или любом) файле убедитесь, что ENVIRONMENT соответствует выбранной среде.

# Примечание:
# Перед запуском приложения установите соответствующее значение переменной окружения ENVIRONMENT:
# например: ENVIRONMENT=dev <запуск приложения>.
# Приложение читает переменные из файла, имя которого совпадает с текущим значением ENVIRONMENT.

# === Режим отладки ===
DEBUG=true|false

# === Настройки логирования ===
LOG_DIR=полный/путь/к/директории/логов
# Уровень логирования (используется, когда DEBUG=false).
# Если DEBUG=true, уровень принудительно устанавливается в DEBUG.
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === Настройки агентов ===
# Источник главной LLM, должен быть определен ОБЯЗАТЕЛЬНО.
# Поддерживаемые типы источников: ollama
MAIN_LLM_SOURCE=ollama
# Главная LLM. Доступные модели: qwen2.5, mistral
MAIN_LLM=mistral

# === Настройки RAG ===
DOC_DIR=полный/путь/к/директории/внутренней/документации
# Для генерации эмбеддингов проект использует модели семейства Sentence-Transformers
# В качестве значения EMBEDDING_MODEL следует указать одну из поддерживаемых моделей
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Настройки векторной БД ===
# Векторная БД. Поддерживаемые типы векторных БД: chroma
VECTOR_DB=chroma
VECTOR_DB_PATH=полный/путь/к/векторной/базе/данных

# === Настройки реляционной БД ===
# База данных. Поддерживаемые типы БД: sqlite
DB=sqlite
# Путь к файлу БД
DB_FILE_PATH=путь/к/файлу/БД

# === Секреты и ключи доступа ===
# Секретная строка для генерации JWT-токена
JWT_SECRET=SECRET
# Секретный ключ для кодирования токена сброса пароля
RESET_PW_TOKEN_SECRET=SECRET
# Секретный ключ для кодирования токена подтверждения (например email)
VERIFICATION_TOKEN_SECRET=SECRET